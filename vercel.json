{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/notes/?$",
      "headers": {
        "Location": "/writing"
      },
      "status": 307
    },
    {
      "src": "^/notes/rss\\.xml$",
      "headers": {
        "Location": "/writing/rss.xml"
      },
      "status": 307
    },
    {
      "src": "^/notes/([^/]+)$",
      "headers": {
        "Location": "/writing/$1"
      },
      "status": 307
    },
    {
      "src": "^/blog/?$",
      "headers": {
        "Location": "/writing"
      },
      "status": 308
    },
    {
      "src": "^/blog/([^/]+)$",
      "headers": {
        "Location": "/writing/$1"
      },
      "status": 308
    },
    {
      "src": "^/(?:(.*)/)?index\\.html$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.*)\\.html$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.+)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/index.md",
      "check": true
    },
    {
      "src": "^/writing/([^/.]+)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/writing/$1.md",
      "check": true
    },
    {
      "src": "^/([^/.]+)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/$1.md",
      "check": true
    },
    {
      "src": "^/$",
      "headers": {
        "Link": "</index.md>; rel=\"describedby\"; type=\"text/markdown\", </writing/rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\""
      },
      "continue": true
    },
    {
      "src": "^/.*$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/_astro/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/fonts/.*$",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1.html",
      "check": true
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
