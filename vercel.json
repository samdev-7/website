{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/notes",
      "destination": "/writing",
      "permanent": false
    },
    {
      "source": "/notes/rss.xml",
      "destination": "/writing/rss.xml",
      "permanent": false
    },
    {
      "source": "/notes/:slug",
      "destination": "/writing/:slug",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/writing/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</index.md>; rel=\"describedby\"; type=\"text/markdown\", </writing/rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/writing",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/writing.md"
    },
    {
      "source": "/writing/:slug",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/writing/:slug.md"
    },
    {
      "source": "/:page",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/:page.md"
    }
  ]
}
