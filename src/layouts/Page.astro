---
import Nav from "../components/Nav.astro";
import pageCss from "../lib/page.css?raw";
import gridJs from "../lib/grid.js?raw";
import pageJs from "../lib/page.js?raw";
import heroJs from "../hero/hero.js?raw";
import Meta from "../components/Meta.astro";
import { heroEdgeSide, heroMinCols, person, SITE } from "../lib/site.mjs";
import handoverJs from "../lib/handover.js?raw";

const { frontmatter = {}, title: propTitle } = Astro.props;
const title = frontmatter.title ?? propTitle;
const description = frontmatter.description ?? `${title} · sam liu`;
const path = Astro.url.pathname,
  notFound = title === "404";
const jsonLd =
  title === "about"
    ? {
        "@type": "ProfilePage",
        url: SITE + "/about",
        name: "about sam liu",
        mainEntity: person(description),
      }
    : {
        "@type": "WebPage",
        url: SITE + path.replace(/\/$/, ""),
        name: `${title} · sam liu`,
        isPartOf: { "@type": "WebSite", "@id": `${SITE}/#site`, url: SITE },
        about: { "@id": `${SITE}/#person` },
      };
const gridScript = gridJs
  .replace("__MIN_COLS__", () => String(heroMinCols(heroJs)))
  .replace("__EDGE_SIDE__", () => String(heroEdgeSide(heroJs)));
const script = pageJs.replace(
  "__DENS__",
  () => heroJs.match(/const DENS = (Float32Array\.of\([^)]*\));/)[1]
);
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Meta title={`${title} · sam liu`} description={description} path={path} type={title === 'about' ? 'profile' : 'website'} jsonLd={notFound ? undefined : jsonLd} noindex={notFound} />
<script is:inline>document.documentElement.classList.add('wait'); setTimeout(() => document.documentElement.classList.remove('wait'), 2000);</script>
<link rel="preload" href="/fonts/IBMPlexMono-Regular-latin.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline set:html={pageCss}></style>
<script is:inline set:html={gridScript}></script>
</head>
<body>
<script is:inline data-from="hero" set:html={handoverJs}></script>
<Nav current={title} />
<main id="content">
  <h1>{title}</h1>
  <div class="rule" aria-hidden="true">{'='.repeat(title.length)}</div>
  <slot />
</main>
<footer>
  <div class="rule" aria-hidden="true">{'-'.repeat(72)}</div>
  <span><a href="/">~</a> / {title}</span>
</footer>
<script is:inline set:html={script}></script>
</body>
</html>
