---
import heroCss from "../hero/hero.css?raw";
import noscriptCss from "../hero/noscript.css?raw";
import heroJs from "../hero/hero.js?raw";
import { titleMetadata, frames, fontB64 } from "../lib/hero-data.mjs";
import { heroMenuHtml, person, SITE } from "../lib/site.mjs";
import Meta from "../components/Meta.astro";
import handoverJs from "../lib/handover.js?raw";

const { subHtml, subText } = titleMetadata(heroJs);
const jsonLd = {
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#site`,
      url: SITE,
      name: "sam liu",
      description: subText,
      publisher: { "@id": `${SITE}/#person` },
    },
    person(subText),
  ],
};
const { first, photoTime, photoIso } = frames();
const script = heroJs
  .replace("__FIRST__", () => first)
  .replace("__FONT__", () => fontB64("IBMPlexMono-Regular-latin.woff2"))
  .replace("__FONT_BOLD__", () => fontB64("IBMPlexMono-Bold-latin.woff2"));
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Meta title="sam liu" description={subText} path="/" jsonLd={jsonLd} />
<link rel="preload" href="/scrub.bin" as="fetch" crossorigin="anonymous" media="(prefers-reduced-motion: no-preference)">
<style is:inline set:html={heroCss}></style>
<noscript><style is:inline set:html={noscriptCss}></style></noscript>
</head>
<body>
<script is:inline data-from="page" set:html={handoverJs}></script>
<main>
<canvas id="art" role="img" aria-label="Colour ASCII-art view from a window: autumn trees, a street lamp and a low building under a blue sky"></canvas>
<div id="title" class="fading"><h1><span id="title-name">sam liu</span></h1><p id="title-sub" set:html={subHtml}></p><p id="title-contact"><a href="mailto:sam@samliu.dev" target="_blank" rel="noopener">sam@samliu.dev</a></p></div>
<nav id="nav" class="fading" aria-label="site" set:html={heroMenuHtml()}></nav>
<p id="info" class="fading"><span class="sr">photo taken in </span><span id="info-place">waterloo, on</span><span class="sr">, at</span>
<time id="info-time" datetime={photoIso}>{photoTime}</time></p>
</main>
<div id="panel" class="hidden" aria-hidden="true">
  <div class="hint">[h] hide panel   [r] replay scrub
<span class="busy" id="busy"></span></div>
</div>
<script is:inline set:html={script}></script>
</body>
</html>
