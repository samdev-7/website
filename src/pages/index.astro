---
import heroCss from "../hero/hero.css?raw";
import noscriptCss from "../hero/noscript.css?raw";
import layoutJs from "../hero/layout.js?raw";
import heroJs from "../hero/hero.js?raw";
import { titleMetadata, fontB64 } from "../lib/hero-data.mjs";
import {
  DATA_URL,
  EMAIL,
  heroMenuHtml,
  person,
  PLACE,
  SITE,
} from "../lib/site.mjs";
import Meta from "../components/Meta.astro";
import handoverJs from "../lib/handover.js?raw";

const { subHtml, subText } = titleMetadata();
const jsonLd = {
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#site`,
      url: SITE,
      name: "sam liu",
      description: subText,
      publisher: { "@id": `${SITE}/#person` },
    },
    person(subText),
  ],
};
const script = (layoutJs + heroJs)
  .replace("__FONT__", () => fontB64("IBMPlexMono-Regular-latin.woff2"))
  .replace("__FONT_BOLD__", () => fontB64("IBMPlexMono-Bold-latin.woff2"));
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Meta title="sam liu" description={subText} path="/" jsonLd={jsonLd} />
<script is:inline set:html={`window.DATA_URL = ${JSON.stringify(DATA_URL)};
{
  const o = '?o=' + location.host;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.latestFrame = fetch(window.DATA_URL + '/ascii/latest.bin' + o, { signal: AbortSignal.timeout(6000) });
  } else {
    window.scrubAbort = new AbortController();
    window.scrubStream = fetch(window.DATA_URL + '/ascii/scrub.bin' + o, { signal: window.scrubAbort.signal });
  }
}`}></script>
<style is:inline set:html={heroCss}></style>
<noscript><style is:inline set:html={noscriptCss}></style></noscript>
</head>
<body>
<script is:inline data-from="page" set:html={handoverJs}></script>
<p id="boot" aria-hidden="true">loading<span class="dots">...</span></p>
<main>
<canvas id="art" role="img" aria-label="Colour ASCII-art view from a window: autumn trees, a street lamp and a low building under a blue sky"></canvas>
<div id="title" class="fading"><h1><span id="title-name">sam liu</span></h1><p id="title-sub" set:html={subHtml}></p><p id="title-contact"><a href={`mailto:${EMAIL}`} target="_blank" rel="noopener">{EMAIL}</a></p></div>
<nav id="nav" class="fading" aria-label="site" set:html={heroMenuHtml()}></nav>
<p id="info" class="fading"><span class="sr">photo taken in </span><span id="info-place">{PLACE}</span><span class="sr">, at</span>
<time id="info-time"></time>
<span id="info-day"><span id="info-live" hidden>live<span class="dot" aria-hidden="true">&bull;</span></span><span id="info-gap"></span><span class="sr">, on </span><span id="info-date"></span></span></p>
</main>
<script is:inline set:html={script}></script>
</body>
</html>
