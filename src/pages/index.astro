---
import BlogCard from "../components/react/BlogCard";
import EmptyCard from "../components/EmptyCard.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import WorkCard from "../components/WorkCard.astro";
import Layout from "../layouts/Layout.astro";
import { listPost } from "../utils/server/notion";
import ClientBlogList from "../components/react/ClientBlogList";
import BlogCardSkeleton from "../components/react/BlogCardSkeleton";

const workDocs = await Astro.glob("./work/*.md");

export const prerender = true;
---

<Layout title="Sam Liu">
  <Navbar />
  <main class="flex justify-center text-gray-800">
    <div class="grow px-10 sm:px-16 md:px-20 max-w-[60rem]">
      <div class="pt-40">
        <p class="text-2xl">Hey there! <span>👋</span></p>
        <h1 class="text-5xl font-medium pt-1 text-black">I'm Sam Liu</h1>
        <p class="pt-4 text-lg">Building things and experiences</p>
      </div>
      <div class="w-full flex justify-center">
        <div class="border-b-2 my-20 w-48 border-gray-200"></div>
      </div>
      <section>
        <div class="leading-8">
          <p>
            I'm an incoming freshman pursuing Mathematics at the University of
            Waterloo who's building random shenanigans and exploring
            out-of-the-box ideas.
          </p>
          <br />
          <p>
            I've built 100-pound robots, engineered contraptions to solve my pet
            peeves, and crafted code that's used by teenagers around the world.
            I spend tons of my free time tinkering and exploring random tech.
            Creating is a superpower, and I get to learn something new every
            time. You can see some of the projects I've been working on on my
            <a
              href="https://github.com/samdev-7"
              target="_blank"
              class="underline decoration-gray-400 motion-safe:hover:decoration-gray-800 motion-safe:transition motion-safe:duration-75"
              >GitHub profile</a
            >.
          </p>
          <br />
          <p>
            From the beginning of high school, I tried to find a community of
            creative, tech-obsessed makers where I could fit in. I found
            <a
              href="https://hackclub.com/"
              target="_blank"
              class="underline decoration-gray-400 motion-safe:hover:decoration-gray-800 motion-safe:transition motion-safe:duration-75"
              >Hack Club</a
            >, and helped spread it across Toronto with events like
            <a
              href="https://youtu.be/QvCoISXfcE8"
              target="_blank"
              class="underline decoration-gray-400 motion-safe:hover:decoration-gray-800 motion-safe:transition motion-safe:duration-75"
              >Canada's largest IRL hackathon for teens</a
            >. I brought the same energy to my hometown with
            <a
              href="https://youtu.be/H5RPsCMl3uM"
              target="_blank"
              class="underline decoration-gray-400 motion-safe:hover:decoration-gray-800 motion-safe:transition motion-safe:duration-75"
              >Ottawa's first-ever IRL high school hackathon</a
            >, kickstarting another vibrant community of teen makers. I aspire
            to bring people together and spread my passion for creating. I'm
            very thankful to everyone who's helped me on this journey, and if
            any of this resonates, please <a
              href="/contact"
              class="underline decoration-gray-400 motion-safe:hover:decoration-gray-800 motion-safe:transition motion-safe:duration-75"
              >reach out</a
            >!
          </p>
          <br />
          <p>
            Welcome to this quiet corner where I document my journey and share
            what I've learned. I'm always down to chat about stuff. I may seem
            awkward at first, but please <a
              href="/contact"
              class="underline decoration-gray-400 motion-safe:hover:decoration-gray-800 motion-safe:transition motion-safe:duration-75"
              >say hi</a
            >!
          </p>
        </div>
      </section>
      <section class="space-y-4 mt-20">
        <div class="flex flex-col space-y-2">
          <h2 class="text-3xl font-medium grow">Featured work</h2>
          <a class="flex space-x-1.5 items-center group" href="/work">
            <p class="group-hover:underline">See all work</p>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5 motion-safe:transition-all motion-safe:group-hover:translate-x-0.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
        <div class="flex gap-x-4">
          <WorkCard
            name={workDocs[0].frontmatter.name}
            desc={workDocs[0].frontmatter.desc}
            href={workDocs[0].url}
          />
          <WorkCard
            class="hidden sm:block"
            name={workDocs[1].frontmatter.name}
            desc={workDocs[1].frontmatter.desc}
            href={workDocs[1].url}
          />
          <WorkCard
            class="hidden md:block"
            name={workDocs[2].frontmatter.name}
            desc={workDocs[2].frontmatter.desc}
            href={workDocs[2].url}
          />
        </div>
      </section>
      <section class="space-y-4 py-20">
        <div class="flex flex-col space-y-2">
          <h2 class="text-3xl font-medium">My blog</h2>
          <a class="flex space-x-1.5 items-center group" href="/blog">
            <p class="group-hover:underline">See all posts</p>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5 motion-safe:transition-all motion-safe:group-hover:translate-x-0.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
        <div>
          <ClientBlogList client:only="react">
            <div slot="fallback" class="flex flex-col space-y-4">
              <BlogCardSkeleton />
              <BlogCardSkeleton />
              <BlogCardSkeleton />
            </div>
          </ClientBlogList>
        </div>
      </section>
    </div>
  </main>
  <div class="sm:h-12"></div>
  <Footer />
</Layout>
