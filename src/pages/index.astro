---
import RootLayout from "../layouts/RootLayout.astro";
import { LANDING_ID, sec2, sec3 } from "../lib/landing-animations";

import Landing from "../components/Landing.svelte";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<RootLayout fadeTarget={LANDING_ID} fadeStart={sec2[0]} fadeEnd={sec3[1]}>
  <noscript>
    <style is:inline>
      /* collapse runway */
      #landing {
        height: 100dvh !important;
      }
      #landing .landing-line {
        position: static !important;
        opacity: 1 !important;
        transform: none !important;
        pointer-events: auto !important;
        margin-block: 1.125rem;
      }
      /* anchor hint */
      #landing .landing-scroll {
        position: absolute !important;
      }
      #landing .landing-greet,
      #landing .landing-skip {
        display: none !important;
      }
    </style>
  </noscript>
  <Landing client:load />
  <main id="content" class="min-h-screen flex flex-col">
    <div class="mx-6 md:mx-12 flex justify-center flex-grow">
      <div
        class="max-w-5xl w-full py-12 space-y-[1lh] text-base sm:text-lg md:text-xl"
      >
        <About />
        <Contact />
      </div>
    </div>
    <Footer />
  </main>
</RootLayout>
