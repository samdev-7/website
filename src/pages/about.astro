---
import RootLayout from "../layouts/RootLayout.astro";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.svelte";
---

<RootLayout>
  <div class="min-h-screen flex flex-col">
    <Navbar />
    <div class="mx-6 md:mx-12 flex justify-center flex-grow">
      <div class="max-w-5xl w-full">
        <div class="my-8 grid grid-cols-5 text-base sm:text-lg md:text-xl">
          <p class="col-span-5 lg:col-span-3">
            hey! i'm sam liu!<br />
            <br />
            i'm a recent high school graduate who is making things that get teens build technical projects @ <a href="https://hackclub.com" target="_blank"
              >hack club</a
            ><br />
            <br />
            i'm excited about...<br />
            - crafting code<br />
            - hardware & electronics<br />
            - bringing people together<br />
            - silly adventures<br />
            - ???<br />
            <br />
            if any of these sound interesting, <a href="/contact">reach out</a
            >!<br />
            and check out <a href="/work">my work</a>!
          </p>
        </div>
      </div>
    </div>
    <Footer />
  </div>
</RootLayout>
