---
import { HOME, PAGES as pages } from "../lib/site.mjs";
interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<nav aria-label="site"><a href="/"><span class="home-full">{HOME}</span><span class="home-short">~</span></a>{pages.map(p => <a href={`/${p}`} aria-current={p === current ? 'page' : undefined}><span>{p}</span></a>)}</nav>
